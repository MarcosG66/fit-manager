{
  "name": "fitmanager-final",
  "private": true,
  "version": "2.0.0",
  "scripts": {
    "setup": "node scripts/setup-dev.mjs",
    "install:all": "npm install --prefix server && npm install --prefix client",
    "dev": "concurrently -k -n API,WEB -c blue,green \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "build": "npm run build --prefix client",
    "start": "npm start --prefix server",
    "format": "prettier --write client/src server/src server/scripts scripts",
    "format:check": "prettier --check client/src server/src server/scripts scripts",
    "db:init": "npm run db:init --prefix server",
    "db:migrate": "npm run db:migrate --prefix server",
    "db:seed": "npm run db:seed --prefix server",
    "db:check": "npm run db:check --prefix server",
    "check": "npm run build && npm run db:check",
    "test": "npm run test --prefix server",
    "test:e2e": "npm run test:e2e --prefix server",
    "audit": "node scripts/audit-static.mjs && npm run test"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
