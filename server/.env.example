NODE_ENV=development
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=fitmanager
DB_PASSWORD=fitmanager_dev_only
DB_NAME=fitmanager
# Gerar: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=COLOQUE_AQUI_UM_SEGREDO_ALEATORIO_COM_PELO_MENOS_32_CARACTERES
# Segredo separado para proteger os codigos de redefinicao no banco
RESET_SECRET=COLOQUE_AQUI_OUTRO_SEGREDO_ALEATORIO_COM_PELO_MENOS_32_CARACTERES
JWT_EXPIRES_IN=8h
# O Mailpit local mostra os e-mails em http://localhost:8025
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=FitManager <no-reply@fitmanager.local>
# Para desenvolvimento, criar contas de exemplo via npm run db:seed
SEED_STUDENT_PASSWORD=
SEED_INSTRUCTOR_PASSWORD=
SEED_ADMIN_PASSWORD=

# Cadastro de administrador: mantenha segredo, 24+ caracteres, informe apenas a pessoas autorizadas
ADMIN_SIGNUP_CODE=
# E-mail via HTTPS na hospedagem (opcional)
RESEND_API_KEY=
RESEND_FROM=
# Certificado CA da hospedagem do MySQL, quando necessário
DB_SSL=false
DB_SSL_CA=
# No servidor de produção, false por segurança; usar db:init manualmente
DB_AUTO_INIT=false
DEMO_SEED=false

# Fuso usado para definir o dia de conclusão de exercícios
APP_TIMEZONE=America/Fortaleza
